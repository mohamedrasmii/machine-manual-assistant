# Copy this file to .env and keep ONE provider block active (no # in front).
# Never commit your real .env file.

# ---- Option 1: Ollama (local, free, no key) ----
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b

# ---- Option 2: Groq (free tier, key from console.groq.com) ----
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-groq-key
# LLM_MODEL=openai/gpt-oss-20b

# ---- Option 3: Google Gemini (free tier, key from aistudio.google.com) ----
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-3.8-flash

# ---- Option 4: OpenAI (paid, needs credit) ----
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your-openai-key
# LLM_MODEL=your-openai-model-name

# Model names change often: copy the current one from the provider's docs.
# Running the app inside Docker with Ollama on your PC? Use:
# LLM_BASE_URL=http://host.docker.internal:11434/v1
